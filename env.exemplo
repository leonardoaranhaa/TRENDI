# Copie para .env e preencha. Nenhum segredo vai para o repositório
# (convenção 5 de 02-arquitetura/convencoes.md).
#
# O nome do arquivo não é `.env.example` porque `.claude/settings.json` nega
# leitura de `.env.*` — regra que protege segredo e acaba pegando o exemplo
# junto. Para usar o nome de sempre, ajuste a regra e renomeie.

# --- Banco -------------------------------------------------------------
# Local: `docker compose up -d` e use a linha abaixo.
# Produção: string do Supabase, região São Paulo — ver decisão D-17.
DATABASE_URL=postgresql://trendi:trendi@localhost:5432/trendi

# --- Endereços ---------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Só em produção, e só quando API e site estiverem no mesmo domínio
# registrável (ex.: .trendi.com.br). Depende de L-01.
# SESSION_COOKIE_DOMAIN=.trendi.com.br

# --- Sessão e tempo real ------------------------------------------------
# Assina o ticket de entrada no WebSocket. Obrigatória em produção.
# Gere com: openssl rand -base64 32
REALTIME_TICKET_SECRET=segredo-de-desenvolvimento

# --- Vídeo (Amazon IVS, decisão D-20) -----------------------------------
# Sem estas, a API sobe sem vídeo: o duelo anda, mas ninguém publica nem
# assiste. É o estado normal até L-19 (criar a conta AWS).
# AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# IVS_CHANNEL_ARN=
# IVS_ENCODER_CONFIGURATION_ARN=
# IVS_STORAGE_CONFIGURATION_ARN=
# IVS_PLAYBACK_URL=

# --- Limite de tentativas -----------------------------------------------
# Cadastro, login e recuperação têm teto por IP. Desligue só para depurar.
# RATE_LIMIT_DISABLED=1

# --- Login --------------------------------------------------------------
# Conta nativa (e-mail e senha) não precisa de configuração nenhuma.
# Falta só o provedor de e-mail (tarefa L-18) para os links de verificação e
# de recuperação saírem daqui; fora de produção eles voltam na resposta.

# Entrar sem Google nem Discord, enquanto L-17 não estiver feita.
# Ignorado em produção, por segurança.
AUTH_FAKE_PROVIDER=1

# Credenciais reais (tarefa L-17):
# Google  -> https://console.cloud.google.com/apis/credentials
#   callback: $API_PUBLIC_URL/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Discord -> https://discord.com/developers/applications
#   callback: $API_PUBLIC_URL/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
